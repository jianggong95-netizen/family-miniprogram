.filter-bar {
  background: #fff;
  padding: 12rpx 0 16rpx;
}

.filter-group {
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx 0;
}

.group-label {
  flex-shrink: 0;
  width: 76rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.group-scroll {
  flex: 1;
  white-space: nowrap;
}

.chips {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 24rpx;
}

.chip {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #F1F5F4;
  color: #4B5563;
}

.chip-active {
  background: #0F6E56;
  color: #fff;
}
