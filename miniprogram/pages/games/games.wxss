.games-head { padding: 40rpx 32rpx 16rpx; }
.games-title { font-size: 40rpx; font-weight: 600; color: #1F2937; }
.games-sub { font-size: 24rpx; color: #6B7280; margin-top: 8rpx; }

.game-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.game-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #fff;
  font-weight: 600;
  flex-shrink: 0;
}
.icon-gomoku { background: #0F6E56; }
.icon-tetris { background: #B45309; }
.icon-plane { background: #1D4ED8; }
.icon-benben { background: #C2410C; }
.icon-bomber { background: #DC2626; }
.icon-score { background: #7C3AED; }
.icon-study { background: #DB2777; }
.icon-perms { background: #334155; }

.game-lock {
  font-size: 24rpx;
  color: #DC2626;
  background: #FEF2F2;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.game-info { flex: 1; }
.game-name { font-size: 32rpx; font-weight: 500; color: #1F2937; }
.game-desc { font-size: 24rpx; color: #6B7280; margin-top: 8rpx; line-height: 1.5; }

.game-arrow { color: #B4B2A9; font-size: 30rpx; }
