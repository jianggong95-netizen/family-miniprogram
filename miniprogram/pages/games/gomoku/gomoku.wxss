.gomoku-page { padding: 24rpx; }

.gomoku-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.gomoku-status { font-size: 32rpx; font-weight: 600; color: #1F2937; }
.gomoku-status.win { color: #B45309; }

.gomoku-btns { display: flex; gap: 16rpx; }
.gbtn {
  font-size: 24rpx;
  color: #0F6E56;
  background: #E1F5EE;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
}
.gbtn.primary { background: #0F6E56; color: #fff; }

.gomoku-canvas-wrap {
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx;
}
.gomoku-canvas { width: 100%; height: 700rpx; }

.gomoku-tip { margin-top: 24rpx; text-align: center; }
.gomoku-tip text { font-size: 24rpx; color: #6B7280; }

/* 模式标签 */
.mode-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.mute-btn {
  width: 96rpx;
  text-align: center;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #6B7280;
}
.mode-tab.active {
  background: #0F6E56;
  color: #fff;
  font-weight: 600;
}

/* 联机大厅 */
.lobby-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}
.lobby-card.center { text-align: center; }
.lobby-title { font-size: 34rpx; font-weight: 600; color: #1F2937; }
.lobby-desc { font-size: 24rpx; color: #6B7280; margin: 12rpx 0 24rpx; line-height: 1.6; }
.lobby-input {
  background: #F4F6F5;
  border: 2rpx solid #0F6E56;
  border-radius: 20rpx;
  padding: 36rpx 24rpx;
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 20rpx;
  text-align: center;
  margin-bottom: 28rpx;
  min-height: 56rpx;
}
.lobby-btn {
  text-align: center;
  padding: 24rpx;
  border-radius: 999rpx;
  background: #E1F5EE;
  color: #0F6E56;
  font-size: 30rpx;
  font-weight: 500;
}
.lobby-btn.primary { background: #0F6E56; color: #fff; }
.room-code {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: #B45309;
  margin: 24rpx 0;
}
.lobby-tip { text-align: center; font-size: 24rpx; color: #9CA3AF; margin-top: 8rpx; }
.lobby-btn.disabled { opacity: 0.5; }
.ready-state { display: flex; justify-content: center; gap: 20rpx; margin-bottom: 28rpx; }
.rchip {
  font-size: 26rpx;
  color: #6B7280;
  background: #F4F6F5;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
}
.rchip.on { background: #E1F5EE; color: #0F6E56; font-weight: 600; }
.code-echo { text-align: center; font-size: 28rpx; color: #6B7280; margin-bottom: 20rpx; }
.code-echo-num { font-size: 44rpx; font-weight: 700; color: #B45309; letter-spacing: 8rpx; }

.gomoku-meta { text-align: center; margin-bottom: 16rpx; }
.gomoku-meta text { font-size: 24rpx; color: #6B7280; }
