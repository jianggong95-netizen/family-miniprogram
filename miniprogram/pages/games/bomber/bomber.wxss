page {
  background: #0b0d12;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.stage {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
}

.game-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* ============ HUD ============ */
.hud {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  box-sizing: border-box;
  pointer-events: none;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.92);
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
}
.hud-group { display: flex; align-items: center; }
.hud-item { margin-right: 12px; }
.hud-v { font-weight: bold; color: #ffd24a; }
.hud-right { margin-left: auto; }
.hud-btn {
  width: 30px;
  height: 30px;
  line-height: 28px;
  margin-left: 8px;
  border-radius: 50%;
  text-align: center;
  font-size: 14px;
  color: #fff;
  background: rgba(255, 255, 255, 0.14);
  border: 1px solid rgba(255, 255, 255, 0.35);
  pointer-events: auto;
}
.hud-btn-hover { background: rgba(255, 255, 255, 0.3); }

/* ============ 摇杆 + 放弹按钮 ============ */
.pad {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

/* 摇杆中心 = (80, winH-84)，与 bomber.js joyCenter() 一致（勿加 env() 内边距，否则触点中心偏移） */
.joy {
  position: absolute;
  left: 16px;
  bottom: 20px;
  width: 128px;
  height: 128px;
  pointer-events: auto;
}
.joy-base {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
}
.joy-stick {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 54px;
  height: 54px;
  margin: -27px 0 0 -27px;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 35%, #6ee7ff, #2b8cff 60%, #1b5fd9);
  box-shadow: 0 6px 18px rgba(43, 140, 255, 0.5);
}

.btn-bomb {
  position: absolute;
  right: calc(16px + env(safe-area-inset-right));
  bottom: calc(20px + env(safe-area-inset-bottom));
  width: 74px;
  height: 74px;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 30%, #ff8a3d, #e23b2e 65%);
  border: 2px solid rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 20px;
  font-weight: 700;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 22px rgba(226, 59, 46, 0.55);
  pointer-events: auto;
}
.bb-sub { font-size: 11px; font-weight: 400; margin-top: 2px; }
.btn-bomb-hover { transform: scale(0.92); }

/* ============ 遮罩 ============ */
.overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(8, 10, 15, 0.82);
  color: #fff;
  text-align: center;
}
.ov-card {
  width: 86%;
  max-width: 420px;
  padding: 22px 20px;
  box-sizing: border-box;
}
.ov-title {
  font-size: 28px;
  font-weight: 800;
  margin-bottom: 6px;
  color: #ffd24a;
}
.ov-sub { font-size: 16px; color: #c9d3e3; margin-bottom: 14px; }
.ov-tip { font-size: 12px; color: #9aa6ba; line-height: 1.8; margin-bottom: 6px; }
.ov-big { font-size: 34px; font-weight: 800; color: #fff; margin: 4px 0 10px; }
.ov-stars { font-size: 28px; letter-spacing: 5px; margin: 6px 0 10px; color: #ffd24a; }
.ov-btn {
  margin-top: 14px;
  display: inline-block;
  min-width: 150px;
  padding: 0 22px;
  height: 42px;
  line-height: 42px;
  font-size: 16px;
  color: #fff;
  font-weight: 700;
  border-radius: 14px;
  background: linear-gradient(135deg, #ff8a3d, #ff5c3d);
  box-shadow: 0 8px 20px rgba(255, 92, 61, 0.35);
}
.ov-btn::after { border: none; }
.ov-btn-ghost { background: rgba(255, 255, 255, 0.12); box-shadow: none; border: 1px solid rgba(255, 255, 255, 0.3); }
.ov-btns { display: flex; justify-content: center; }
.ov-btns .ov-btn { margin-left: 8px; margin-right: 8px; }

/* ============ 选关宫格 ============ */
.level-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin: 12px 0 4px;
}
.lvl {
  width: 62px;
  height: 62px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 16px;
  font-weight: 700;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.lvl-sub { font-size: 9px; color: #8b96aa; font-weight: 400; margin-top: 2px; }
.lvl-locked { color: #5f6878; }
.lvl-cleared { background: rgba(255, 210, 74, 0.14); border-color: rgba(255, 210, 74, 0.5); }
.lvl-cleared .lvl-sub { color: #ffd24a; }
