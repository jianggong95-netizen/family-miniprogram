.plane-page { display: flex; flex-direction: column; height: 100vh; background: #0B1026; box-sizing: border-box; }

/* 顶部 HUD */
.hud {
  display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 12rpx;
  padding: 12rpx 16rpx;
  background: #111A38;
  color: #E2E8F0;
  font-size: 22rpx;
}
.hud-item { white-space: nowrap; }
.hud-num { color: #34D399; font-weight: 700; font-size: 26rpx; }
.gbtn {
  margin-left: auto;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #1E293B;
  color: #E2E8F0;
  font-size: 24rpx;
  white-space: nowrap;
}
.gbtn + .gbtn { margin-left: 0; }
.gbtn.primary { background: #0F6E56; color: #fff; }

/* BOSS 血条 */
.boss-bar { position: relative; height: 14rpx; margin: 12rpx 24rpx 0; background: #1E293B; border-radius: 999rpx; overflow: hidden; }
.boss-fill { height: 100%; background: linear-gradient(90deg, #F43F5E, #FB923C); transition: width 0.2s; }
.boss-label { position: absolute; top: -2rpx; left: 8rpx; font-size: 18rpx; color: #fff; font-weight: 700; }

/* 画布 */
.plane-canvas-wrap { flex: 1; position: relative; margin: 12rpx 16rpx; border-radius: 24rpx; overflow: hidden; background: #0B1026; }
.plane-canvas { width: 100%; height: 100%; display: block; }

/* 遮罩层 */
.overlay {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: rgba(11, 16, 38, 0.82);
  color: #E2E8F0;
  padding: 40rpx;
  box-sizing: border-box;
}
.ov-title { font-size: 56rpx; font-weight: 700; color: #34D399; }
.ov-desc { font-size: 28rpx; color: #94A3B8; margin-top: 12rpx; }
.ov-rules { margin-top: 32rpx; font-size: 26rpx; line-height: 2; color: #CBD5E1; text-align: center; }
.ov-mask-text { font-size: 40rpx; font-weight: 700; text-align: center; line-height: 1.6; white-space: pre-line; }
.ov-btn {
  margin-top: 40rpx;
  padding: 24rpx 80rpx;
  border-radius: 999rpx;
  background: #0F6E56;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
.ov-btn.ghost { background: transparent; border: 2rpx solid #475569; color: #94A3B8; margin-top: 20rpx; }

/* 大招栏 */
.bomb-bar { padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); background: #111A38; text-align: center; }
.bomb-btn {
  padding: 26rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #0891B2, #22D3EE);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}
.bomb-btn.off { opacity: 0.4; }
.bomb-tip { font-size: 22rpx; color: #64748B; margin-top: 10rpx; }
