<view class="page">
  <!-- 图片区 -->
  <view class="card">
    <view class="img-grid">
      <view class="img-item" wx:for="{{images}}" wx:key="id">
        <image src="{{item.url}}" mode="aspectFill" class="img" />
        <view class="img-del" data-idx="{{index}}" bindtap="removeUploaded">x</view>
      </view>
      <view class="img-item" wx:for="{{newImages}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" class="img" />
        <view class="img-del" data-idx="{{index}}" bindtap="removeNew">x</view>
      </view>
      <view class="img-add" bindtap="chooseImages">
        <view class="add-icon">+</view>
        <view class="add-text">拍照/相册</view>
      </view>
    </view>
    <view class="tip">最多 9 张，第一张为封面（{{images.length + newImages.length}}/9）</view>
  </view>

  <!-- 基础信息 -->
  <view class="card">
    <view class="form-row">
      <text class="label">名称 *</text>
      <input class="input" placeholder="如：白色圆领短袖T恤" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>

    <view class="form-row">
      <text class="label">归属</text>
      <picker range="{{members}}" range-key="name" value="{{ownerIdx}}" bindchange="pickOwner">
        <view class="picker-value">{{members[ownerIdx] ? members[ownerIdx].name : '请选择'}}</view>
      </picker>
    </view>

    <view class="form-row">
      <text class="label">种类</text>
      <picker range="{{categories}}" range-key="name" value="{{categoryIdx}}" bindchange="pickCategory">
        <view class="picker-value">{{form.category || '请选择'}}</view>
      </picker>
    </view>

    <view class="form-row">
      <text class="label">二级分类</text>
      <input class="input" placeholder="如：短袖 / 牛仔裤（选填）" value="{{form.sub_category}}" data-field="sub_category" bindinput="onInput" />
    </view>

    <view class="form-row">
      <text class="label">颜色</text>
      <picker range="{{colors}}" range-key="name" value="{{colorIdx}}" bindchange="pickColor">
        <view class="picker-value">{{form.color || '请选择'}}</view>
      </picker>
    </view>

    <view class="form-row">
      <text class="label">季节</text>
      <picker range="{{seasons}}" range-key="name" value="{{seasonIdx}}" bindchange="pickSeason">
        <view class="picker-value">{{form.season}}</view>
      </picker>
    </view>

    <view class="form-row">
      <text class="label">尺码</text>
      <input class="input" placeholder="如：M / 170" value="{{form.size}}" data-field="size" bindinput="onInput" />
    </view>

    <view class="form-row">
      <text class="label">品牌</text>
      <input class="input" placeholder="选填" value="{{form.brand}}" data-field="brand" bindinput="onInput" />
    </view>

    <view class="form-row">
      <text class="label">材质</text>
      <input class="input" placeholder="如：纯棉（选填）" value="{{form.material}}" data-field="material" bindinput="onInput" />
    </view>

    <view class="form-row">
      <text class="label">数量</text>
      <input class="input" type="number" value="{{form.quantity}}" data-field="quantity" bindinput="onInput" />
    </view>

    <view class="form-row">
      <text class="label">存放位置</text>
      <picker range="{{locations}}" range-key="name" value="{{locationIdx}}" bindchange="pickLocation">
        <view class="picker-value">{{form.location || '请选择'}}</view>
      </picker>
    </view>

    <view class="form-row">
      <text class="label">购入价</text>
      <input class="input" type="digit" placeholder="元（选填）" value="{{form.purchase_price}}" data-field="purchase_price" bindinput="onInput" />
    </view>

    <view class="form-row">
      <text class="label">购入日期</text>
      <picker mode="date" value="{{form.purchase_date}}" bindchange="pickDate">
        <view class="picker-value {{form.purchase_date ? '' : 'placeholder'}}">{{form.purchase_date || '选择日期'}}</view>
      </picker>
    </view>

    <view class="form-row">
      <text class="label">标签</text>
      <input class="input" placeholder="逗号分隔，如：正装,常穿" value="{{form.tags}}" data-field="tags" bindinput="onInput" />
    </view>

    <view class="form-col">
      <text class="label">备注</text>
      <textarea class="textarea" placeholder="选填" value="{{form.note}}" data-field="note" bindinput="onInput" maxlength="500" />
    </view>
  </view>

  <view class="submit-wrap">
    <button class="btn-primary" loading="{{submitting || uploading}}" disabled="{{submitting || uploading}}" bindtap="submit">保存</button>
  </view>
</view>
