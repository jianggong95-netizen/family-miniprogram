.swiper {
  width: 100%;
  height: 640rpx;
  background: #E8ECEB;
}

.swiper-img { width: 100%; height: 100%; }

.no-img {
  width: 100%;
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E8ECEB;
  color: #B4B2A9;
  font-size: 26rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.name { font-size: 36rpx; font-weight: 500; }

.status {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}
.status-stock { background: #E1F5EE; color: #0F6E56; }
.status-borrow { background: #FAEEDA; color: #BA7517; }
.status-done { background: #F1F5F4; color: #9CA3AF; }

.price-qty {
  display: flex;
  justify-content: space-between;
  margin: 16rpx 0;
}

.qty { font-size: 28rpx; font-weight: 500; color: #0F6E56; }
.price { font-size: 28rpx; color: #D85A30; font-weight: 500; }

.note {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #4B5563;
}

.action-row {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 8rpx;
  margin-bottom: 24rpx;
}
.action-row .btn-primary { flex: 2; }
.action-row .btn-ghost, .action-row .btn-danger { flex: 1; }

.record {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}
.record:last-child { border-bottom: none; }

.record-type {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #F1F5F4;
  color: #6B7280;
  margin-top: 4rpx;
}
.type-in { background: #E1F5EE; color: #0F6E56; }
.type-out, .type-gift, .type-clean { background: #FCEBEB; color: #D85A30; }
.type-borrow { background: #FAEEDA; color: #BA7517; }
.type-return { background: #EAF3DE; color: #3B6D11; }

.record-main { flex: 1; }
.record-line { font-size: 26rpx; }
.record-sub { font-size: 22rpx; color: #6B7280; margin-top: 4rpx; }
.record-time { font-size: 20rpx; color: #B4B2A9; }

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx 60rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  margin-bottom: 28rpx;
}

.sheet-item { margin-bottom: 24rpx; }
.sheet-label { font-size: 26rpx; color: #6B7280; display: block; margin-bottom: 12rpx; }

.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-chip {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #F1F5F4;
  font-size: 26rpx;
}
.type-chip-active {
  background: #0F6E56;
  color: #fff;
}

.sheet-input {
  height: 80rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.submit-btn { width: 100%; margin-top: 16rpx; }
