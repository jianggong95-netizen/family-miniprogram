.study-page { padding: 24rpx; min-height: 100vh; background: #FDF6F0; box-sizing: border-box; }

/* 首页 */
.study-head { padding: 24rpx 16rpx 32rpx; }
.study-title { font-size: 44rpx; font-weight: 700; color: #9D174D; }
.study-sub { font-size: 26rpx; color: #9CA3AF; margin-top: 8rpx; }
.study-score { margin-top: 16rpx; font-size: 26rpx; color: #6B7280; }
.score-num { font-size: 36rpx; font-weight: 700; color: #DB2777; }

.mod-card {
  display: flex; align-items: center; gap: 24rpx;
  background: #fff; border-radius: 24rpx; padding: 32rpx;
  margin-bottom: 24rpx;
}
.mod-icon {
  width: 88rpx; height: 88rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 40rpx; font-weight: 700; flex-shrink: 0;
}
.mod-info { flex: 1; }
.mod-name { font-size: 32rpx; font-weight: 600; color: #1F2937; }
.mod-desc { font-size: 24rpx; color: #6B7280; margin-top: 6rpx; }
.mod-arrow { color: #B4B2A9; font-size: 30rpx; }
.study-tip { text-align: center; font-size: 24rpx; color: #9CA3AF; margin-top: 8rpx; }

/* 答题 */
.quiz-bar {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; border-radius: 20rpx; padding: 20rpx 28rpx; margin-bottom: 24rpx;
}
.quiz-mod { font-size: 28rpx; font-weight: 600; color: #9D174D; }
.quiz-progress { font-size: 26rpx; color: #6B7280; }
.quiz-right { font-size: 26rpx; color: #0F6E56; }

.passage {
  background: #fff; border-radius: 24rpx; padding: 32rpx;
  font-size: 30rpx; line-height: 1.9; color: #374151; margin-bottom: 24rpx;
  border-left: 8rpx solid #DB2777;
}
.question { font-size: 34rpx; font-weight: 600; color: #1F2937; padding: 8rpx 16rpx 24rpx; }

.opts { display: flex; flex-direction: column; gap: 20rpx; }
.opt {
  display: flex; align-items: center; gap: 20rpx;
  background: #fff; border: 3rpx solid #E5E7EB; border-radius: 20rpx;
  padding: 28rpx 28rpx; font-size: 32rpx; color: #1F2937;
}
.opt-tag {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #F4F6F5; color: #6B7280; font-weight: 700; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.opt.right { border-color: #0F6E56; background: #E1F5EE; }
.opt.right .opt-tag { background: #0F6E56; color: #fff; }
.opt.wrong { border-color: #DC2626; background: #FEF2F2; }
.opt.wrong .opt-tag { background: #DC2626; color: #fff; }
.opt.show-right { border-color: #0F6E56; }

.feedback { margin-top: 28rpx; border-radius: 20rpx; padding: 24rpx 28rpx; font-size: 28rpx; line-height: 1.7; }
.feedback.good { background: #E1F5EE; color: #0F6E56; }
.feedback.bad { background: #FEF2F2; color: #B91C1C; }
.next-btn {
  margin-top: 28rpx; text-align: center; padding: 30rpx;
  background: #DB2777; color: #fff; border-radius: 999rpx;
  font-size: 34rpx; font-weight: 700;
}

/* 成绩 */
.result-card { background: #fff; border-radius: 32rpx; padding: 80rpx 40rpx; text-align: center; margin-top: 80rpx; }
.result-emoji { font-size: 100rpx; }
.result-text { font-size: 40rpx; font-weight: 700; color: #1F2937; margin-top: 24rpx; }
.result-score { font-size: 28rpx; color: #6B7280; margin-top: 16rpx; }
.result-btns { display: flex; gap: 24rpx; margin-top: 48rpx; }
.rbtn { flex: 1; text-align: center; padding: 28rpx; border-radius: 999rpx; background: #F4F6F5; color: #374151; font-size: 32rpx; font-weight: 600; }
.rbtn.primary { background: #DB2777; color: #fff; }
