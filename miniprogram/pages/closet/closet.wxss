.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #F1F5F4;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
}

.search-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 36rpx;
  background: #0F6E56;
  color: #fff;
  font-size: 26rpx;
}

.list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 20rpx 24rpx 140rpx;
}

.loading-tip {
  text-align: center;
  color: #9CA3AF;
  font-size: 24rpx;
  padding: 20rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #0F6E56;
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 110, 86, 0.4);
}
