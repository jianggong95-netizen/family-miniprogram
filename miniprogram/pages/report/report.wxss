page { background: #F4F6F5; }

.retry { width: 240rpx; margin: 32rpx auto 0; }

.empty-small {
  text-align: center;
  color: #9CA3AF;
  font-size: 24rpx;
  padding: 28rpx 0 8rpx;
}

/* 筛选器 */
.filter-wrap {
  background: #fff;
  padding: 20rpx 24rpx 24rpx;
}
.range-scroll { white-space: nowrap; }
.range-row { display: inline-flex; gap: 16rpx; padding-bottom: 6rpx; }
.range-chip {
  display: inline-flex;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: #F1F5F4;
  color: #6B7280;
}
.range-chip.active {
  background: #0F6E56;
  color: #fff;
  font-weight: 500;
}
.custom-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}
.date-box {
  flex: 1;
  padding: 16rpx 20rpx;
  border: 1rpx solid #E5E7EB;
  border-radius: 14rpx;
  font-size: 26rpx;
}
.date-box.placeholder { color: #9CA3AF; }
.date-sep { color: #9CA3AF; font-size: 24rpx; }
.apply-btn { flex-shrink: 0; line-height: 72rpx; height: 72rpx; }
.btn-ghost::after { border: none; }

/* 汇总卡片 */
.summary-card {
  margin: 24rpx 24rpx 0;
  background: linear-gradient(160deg, #0F6E56 0%, #1D9E75 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  color: #fff;
}
.summary-title { font-size: 26rpx; opacity: 0.9; margin-bottom: 20rpx; }
.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.s-item { text-align: center; }
.s-val { font-size: 32rpx; font-weight: 600; }
.s-label { font-size: 22rpx; opacity: 0.85; margin-top: 6rpx; }
.summary-sub {
  margin-top: 20rpx;
  font-size: 22rpx;
  opacity: 0.85;
  border-top: 1rpx solid rgba(255,255,255,0.2);
  padding-top: 16rpx;
}

/* 趋势图 */
.trend-chart {
  display: flex;
  align-items: flex-end;
  gap: 18rpx;
  height: 260rpx;
  padding-top: 24rpx;
}
.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
}
.trend-bar {
  width: 100%;
  max-width: 56rpx;
  background: linear-gradient(180deg, #1D9E75, #0F6E56);
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  min-height: 12rpx;
}
.trend-amount {
  font-size: 16rpx;
  color: #0F6E56;
  transform: scale(0.9);
  margin-top: -4rpx;
  white-space: nowrap;
}
.trend-month { font-size: 20rpx; color: #6B7280; margin-top: 10rpx; }

/* 进销存 */
.stock-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
}
.stock-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(15, 110, 86, 0.06);
}
.stock-num { font-size: 36rpx; font-weight: 500; color: #0F6E56; }
.stock-num.stock-red { color: #D85A30; }
.stock-label { font-size: 22rpx; color: #6B7280; margin-top: 6rpx; }

/* 分布 */
.dist-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}
.dist-row:last-child { border-bottom: none; }
.dist-name { font-size: 26rpx; }
.dist-val { font-size: 24rpx; color: #6B7280; }

/* 季节 */
.season-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx 8rpx;
}
.season-item {
  flex: 1 1 40%;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
}
.season-name { font-size: 26rpx; font-weight: 500; }
.season-cnt { font-size: 22rpx; color: #6B7280; margin-top: 4rpx; }

/* 明细 */
.record {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}
.record:last-child { border-bottom: none; }
.record-left { display: flex; flex-direction: column; }
.pu-name { font-size: 27rpx; }
.pu-meta { font-size: 22rpx; color: #9CA3AF; margin-top: 4rpx; }
.record-right { text-align: right; }
.pu-qty { font-size: 24rpx; color: #0F6E56; font-weight: 500; display: block; }
.pu-price { font-size: 26rpx; color: #D85A30; font-weight: 500; margin-top: 4rpx; display: block; }