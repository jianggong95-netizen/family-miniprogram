.tip-card {
  margin: 24rpx;
  background: #E1F5EE;
  border-radius: 24rpx;
  padding: 28rpx;
}

.tip-title { font-size: 28rpx; font-weight: 500; color: #0F6E56; margin-bottom: 12rpx; }
.tip-line { font-size: 24rpx; color: #0F6E56; opacity: 0.9; line-height: 1.8; }

.member {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}
.member:last-child { border-bottom: none; }

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #E1F5EE;
  color: #0F6E56;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.info { flex: 1; }
.name { font-size: 28rpx; font-weight: 500; display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.sub { font-size: 22rpx; color: #6B7280; margin-top: 4rpx; }

.role-tag, .bound, .unbound {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 400;
}
.role-tag { background: #0F6E56; color: #fff; }
.bound { background: #E1F5EE; color: #0F6E56; }
.unbound { background: #FAEEDA; color: #BA7517; }

.toggle {
  font-size: 24rpx;
  color: #D85A30;
  padding: 8rpx 20rpx;
  border: 1rpx solid #F5C4B3;
  border-radius: 999rpx;
}

.add-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
}

.add-row { display: flex; gap: 16rpx; }

.add-input {
  flex: 1;
  height: 80rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.add-btn { flex-shrink: 0; height: 80rpx; line-height: 80rpx; font-size: 28rpx; }
