.hero {
  background: linear-gradient(160deg, #0F6E56 0%, #1D9E75 100%);
  padding: 44rpx 40rpx 56rpx;
  color: #fff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-link {
  font-size: 24rpx;
  font-weight: 400;
  opacity: 0.9;
  padding: 8rpx 4rpx 8rpx 24rpx;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
  margin-top: -32rpx;
}

.stat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(15, 110, 86, 0.06);
}

.stat-main { background: #E1F5EE; }

.stat-num {
  font-size: 36rpx;
  font-weight: 500;
  color: #0F6E56;
}

.stat-label {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 6rpx;
}

.member-scroll {
  white-space: nowrap;
  padding: 0 12rpx;
}

.member-row {
  display: inline-flex;
  gap: 20rpx;
  padding: 0 12rpx 10rpx;
}

.member-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  min-width: 140rpx;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #E1F5EE;
  color: #0F6E56;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-name { font-size: 24rpx; margin-top: 12rpx; }
.member-cnt { font-size: 22rpx; color: #6B7280; margin-top: 4rpx; }

.season-grid {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 8rpx;
}

.season-item {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
}

.season-name { font-size: 26rpx; font-weight: 500; }
.season-cnt { font-size: 22rpx; color: #6B7280; margin-top: 4rpx; }

.record {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F1F5F4;
}
.record:last-child { border-bottom: none; }

.record-left { display: flex; align-items: center; gap: 16rpx; }

.record-type {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #F1F5F4;
  color: #6B7280;
  flex-shrink: 0;
}
.type-in { background: #E1F5EE; color: #0F6E56; }
.type-out, .type-gift, .type-clean { background: #FCEBEB; color: #D85A30; }
.type-borrow { background: #FAEEDA; color: #BA7517; }
.type-return { background: #EAF3DE; color: #3B6D11; }

.record-name { font-size: 26rpx; }
.record-right { text-align: right; }
.record-qty { font-size: 24rpx; color: #0F6E56; font-weight: 500; }
.record-time { display: block; font-size: 20rpx; color: #B4B2A9; margin-top: 4rpx; }

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #0F6E56;
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 110, 86, 0.4);
}
